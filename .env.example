# Server-side environment for docker compose (created on the server, NOT committed).
# Copy this to the server as ~/workpulse/.env and fill in real values.

# Public domain / URL the app is served from (Caddy auto-provisions HTTPS).
DOMAIN=workpulse.example.com
APP_URL=https://workpulse.example.com

# Database
DB_DATABASE=workpulse
DB_USERNAME=workpulse
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_PASSWORD=change_me_app_password

# Must be at least 32 characters (backend enforces this).
JWT_SECRET=change_me_to_a_long_random_string_of_at_least_32_chars

# Set to true on the FIRST deploy ONLY.
# It drops+recreates all tables and re-seeds (per the app's migration design),
# so leaving it true will WIPE production data on every deploy.
RUN_DB_MIGRATE=false