// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  MEMBER
  MANAGER
  ADMIN
}

enum ReportStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum ProjectRole {
  MEMBER
  MANAGER
  ADMIN
}

enum HoursCategory {
  DEVELOPMENT
  DESIGN
  TESTING
  MEETINGS
  DEPLOYMENT
  RESEARCH
  SUPPORT
  DOCUMENTATION
  OTHER
}

model User {
  id            String           @id @default(cuid())
  email         String           @unique
  password      String
  name          String
  role          Role             @default(MEMBER)
  position      String?
  avatarUrl     String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  userProjects  UserProject[]
  reports       Report[]
  reviewComments ReviewComment[]
  reviewedReports Report[]       @relation("ReportReviewedBy")
  reportVersionsCreated ReportVersion[] @relation("ReportVersionCreatedBy")
}

model Project {
  id           String         @id @default(cuid())
  name         String
  description  String?
  color        String?
  status       String?        @default("ACTIVE")
  startDate    DateTime?
  endDate      DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  userProjects UserProject[]
  reports      Report[]
  tasks        TaskEntry[]
  blockers     Blocker[]
  achievements Achievement[]
  hoursByType  HoursByType[]
}

model UserProject {
  id        String    @id @default(cuid())
  userId    String
  projectId String
  role      ProjectRole @default(MEMBER)
  assignedAt DateTime @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([projectId])
  @@index([userId])
}

model Report {
  id            String          @id @default(cuid())
  userId        String
  projectId     String
  weekStart     DateTime
  weekEnd       DateTime
  title         String?
  summary       String?
  status        ReportStatus    @default(DRAFT)
  submittedAt   DateTime?
  reviewedAt    DateTime?
  reviewedById  String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  project       Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reviewedBy    User?           @relation("ReportReviewedBy", fields: [reviewedById], references: [id])
  versions      ReportVersion[]
  tasks         TaskEntry[]
  blockers      Blocker[]
  achievements  Achievement[]
  hoursByType   HoursByType[]
  reviewComments ReviewComment[]

  @@index([userId])
  @@index([projectId])
  @@index([status])
}

model ReportVersion {
  id          String   @id @default(cuid())
  reportId    String
  version     Int
  title       String?
  summary     String?
  content     Json?
  createdAt   DateTime @default(now())
  createdById String?
  report      Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  createdBy   User?    @relation("ReportVersionCreatedBy", fields: [createdById], references: [id])

  @@unique([reportId, version])
  @@index([reportId])
}

model TaskEntry {
  id        String   @id @default(cuid())
  reportId  String
  projectId String?
  title     String
  status    String   @default("IN_PROGRESS")
  hours     Float?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  project   Project? @relation(fields: [projectId], references: [id])

  @@index([reportId])
  @@index([projectId])
}

model Blocker {
  id        String   @id @default(cuid())
  reportId  String
  projectId String?
  title     String
  description String?
  status    String   @default("OPEN")
  impact    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  project   Project? @relation(fields: [projectId], references: [id])

  @@index([reportId])
  @@index([projectId])
}

model Achievement {
  id        String   @id @default(cuid())
  reportId  String
  projectId String?
  title     String
  description String?
  createdAt DateTime @default(now())
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  project   Project? @relation(fields: [projectId], references: [id])

  @@index([reportId])
  @@index([projectId])
}

model HoursByType {
  id        String         @id @default(cuid())
  reportId  String
  projectId String?
  category  HoursCategory  @default(DEVELOPMENT)
  hours     Float
  createdAt DateTime       @default(now())
  report    Report         @relation(fields: [reportId], references: [id], onDelete: Cascade)
  project   Project?       @relation(fields: [projectId], references: [id])

  @@index([reportId])
  @@index([projectId])
}

model ReviewComment {
  id        String   @id @default(cuid())
  reportId  String
  userId    String
  comment   String
  isResolved Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([userId])
}
